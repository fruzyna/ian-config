[Unit]
Description=WildRank Production Server

[Container]
ContainerName=%N
Image=ghcr.io/wildstang/wildrank:5.2.0
AutoUpdate=registry
HealthCmd=curl http://127.0.0.1:80

Environment=WR_WORKERS=10

PublishPort=8010:80

Volume=%h/config/%N:/app/config:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
