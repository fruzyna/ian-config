[Unit]
Description=Personal Site Server

[Container]
ContainerName=%N
Image=ghcr.io/fruzyna/site
AutoUpdate=registry
HealthCmd=curl http://127.0.0.1:8000

User=1000:1000
UserNS=keep-id

PublishPort=8000:8000

Volume=%h/config/%N:/app/config:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
