[Unit]
Description=WildRank Testing Server

[Container]
ContainerName=%N
Image=ghcr.io/wildstang/wildrank:5.2.0
AutoUpdate=registry
HealthCmd=curl http://127.0.0.1:80

Environment=WR_WORKERS=3

PublishPort=8011:80

Volume=%h/config/%N:/config:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
